<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.handy.mnnchat">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.INTERNET" />
  <application android:label="TextLLM MNN" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false" android:extractNativeLibs="true">
    <uses-native-library android:name="libOpenCL.so" android:required="false" />
    <activity android:name=".TextLlmActivity" android:exported="true" android:configChanges="orientation|screenSize|keyboardHidden" android:windowSoftInputMode="adjustResize">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity>
  </application>
</manifest>
